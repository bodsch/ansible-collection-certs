#jinja2: trim_blocks: True, lstrip_blocks: True
# {{ ansible_managed }}

[Unit]
Description         = Run lego-renew periodically

[Timer]
OnCalendar          = {{ cert_renew_timer.on_calendar }}
{% if cert_renew_timer.randomized_delay | default('') | string | length > 0 %}
RandomizedDelaySec  = {{ cert_renew_timer.randomized_delay }}
{% endif %}
Persistent          = true

[Install]
WantedBy            = timers.target
