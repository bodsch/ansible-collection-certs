# {{ ansible_managed }}

[Unit]
Description         = Issue and renew TLS certificates via lego
Documentation       = https://go-acme.github.io/lego/
Documentation       = https://github.com/bodsch/ansible-collection-certs

Wants               = network-online.target
After               = network-online.target

[Service]
Type                = oneshot
ExecStart           = {{ cert_manager_script }}

SyslogIdentifier    = cert-manager
